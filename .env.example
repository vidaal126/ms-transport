# Obrigatorias
DATABASE_URL=postgresql://transport:transport@localhost:5433/transport?schema=public
KAFKA_BROKER=localhost:9092

# Opcionais (valores padrao)
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
KAFKA_CLIENT_ID=ms-transport
# Replay: group temporario fixo (ex.: ms-transport.catalog-item-sync.replay-20260923)
CATALOG_SYNC_GROUP_ID=ms-transport.catalog-item-sync
CONSUMER_RETRY_RETRIES=5
CONSUMER_RETRY_INITIAL_MS=300
CONSUMER_RETRY_MAX_MS=30000
CONSUMER_PAUSE_MS=30000
THROTTLE_DEFAULT_TTL_MS=60000
THROTTLE_DEFAULT_LIMIT=100
SHUTDOWN_TIMEOUT_MS=10000
HEALTH_CHECK_TIMEOUT_MS=1500

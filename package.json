{
  "name": "ms-transport",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "patch-package",
    "prebuild": "mkdir -p dist/src/infrastructure/database/generated && cp -r src/infrastructure/database/generated/. dist/src/infrastructure/database/generated/",
    "build": "nest build",
    "prestart": "mkdir -p dist/src/infrastructure/database/generated && cp -r src/infrastructure/database/generated/. dist/src/infrastructure/database/generated/",
    "start": "nest start",
    "prestart:dev": "mkdir -p dist/src/infrastructure/database/generated && cp -r src/infrastructure/database/generated/. dist/src/infrastructure/database/generated/",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "prisma": {
    "seed": "ts-node src/infrastructure/database/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/microservices": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/throttler": "^6",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8",
    "kafkajs": "2.2.4",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.16.0",
    "jest": "^29",
    "patch-package": "^8.0.1",
    "pino-pretty": "^13.1.3",
    "postinstall-postinstall": "^2.1.0",
    "prisma": "^7.9.1",
    "ts-jest": "^29",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ],
    "moduleNameMapper": {
      "^@domain/(.*)$": "<rootDir>/domain/$1",
      "^@application/(.*)$": "<rootDir>/application/$1",
      "^@infrastructure/(.*)$": "<rootDir>/infrastructure/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  }
}
